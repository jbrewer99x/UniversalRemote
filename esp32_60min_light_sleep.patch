 static constexpr uint32_t BATTERY_UPDATE_INTERVAL_MS = 30000;
-static constexpr uint32_t IMU_CHECK_INTERVAL_MS = 100;
+// 4 Hz is still quick enough to feel immediate when the remote is picked up,
+// while reducing I2C/CPU work during the screen-off period.
+static constexpr uint32_t IMU_CHECK_INTERVAL_MS = 250;
 static constexpr uint32_t IMU_WAKE_GRACE_MS = 750;
 static constexpr float IMU_WAKE_THRESHOLD_G = 0.12f;
+// Keep normal screen-off + IMU wake for an hour before true light sleep.
+static constexpr uint32_t LIGHT_SLEEP_AFTER_MS =
+    60UL * 60UL * 1000UL;
@@ -278,13 +286,55 @@
 void wakeScreen(const char* reason) {
     if (!screenSleeping) return;

     screenSleeping = false;
     uint8_t wakeBrightness = uiBrightness == 0 ? 1 : uiBrightness;
     setDisplayBrightness(wakeBrightness);
     noteActivity();
     refreshBatteryStatus();

     Serial.printf("Sleep: woke by %s\n", reason);
     primeImuBaseline();
 }

+void enterLightSleep() {
+    if (!screenSleeping) return;
+
+    if (findRemoteActive || soundTestActive || isAudioPlaying()) {
+        return;
+    }
+
+    Serial.println("Sleep: 60 minutes idle; entering ESP32 light sleep");
+
+    WiFi.disconnect(false, false);
+    WiFi.mode(WIFI_OFF);
+    delay(30);
+
+    pinMode(TOUCH_WAKE_PIN, INPUT_PULLUP);
+    gpio_wakeup_enable(
+        (gpio_num_t)TOUCH_WAKE_PIN,
+        GPIO_INTR_LOW_LEVEL
+    );
+    esp_sleep_enable_gpio_wakeup();
+
+    Serial.println("Sleep: light sleep armed; touch screen to wake");
+    Serial.flush();
+
+    esp_err_t sleepResult = esp_light_sleep_start();
+
+    gpio_wakeup_disable((gpio_num_t)TOUCH_WAKE_PIN);
+    esp_sleep_disable_wakeup_source(ESP_SLEEP_WAKEUP_GPIO);
+
+    if (sleepResult != ESP_OK) {
+        Serial.printf(
+            "Sleep: esp_light_sleep_start failed: %d\n",
+            (int)sleepResult
+        );
+    } else {
+        Serial.println("Sleep: woke from light sleep");
+    }
+
+    lastWifiAttempt = 0;
+    connectWifi();
+    wakeScreen("touch/light sleep");
+}
